<Project><PropertyGroup>
  <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
  <Version>2.0.24</Version><AssemblyVersion>2.0.0.0</AssemblyVersion>
  <FileVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value).0</FileVersion>
  <LangVersion>latest</LangVersion><Deterministic>true</Deterministic><NuGetAudit>true</NuGetAudit>
</PropertyGroup></Project>
