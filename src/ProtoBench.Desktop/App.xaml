<Application x:Class="ProtoBench.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls" xmlns:local="using:ProtoBench.Desktop.Controls">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="TabViewBorderBrush" Color="#FF707070" />
     <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="#FF929292" />
     <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#FFD0D0D0" />
     <SolidColorBrush x:Key="TabViewItemSeparator" Color="#FF929292" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
     <SolidColorBrush x:Key="TabViewItemUnselectedBackground" Color="#FF282828" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FF4A4A4A" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#FF363636" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#FF404040" />
     <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF626C79" />
     <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF778392" />
     <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFA7B4C5" />
     <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF778392" />
     <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFA7B4C5" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="TabViewBorderBrush" Color="#FF909090" />
     <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="#FF808080" />
     <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="#FF4E4E4E" />
     <SolidColorBrush x:Key="TabViewItemSeparator" Color="#FF808080" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
     <SolidColorBrush x:Key="TabViewItemUnselectedBackground" Color="#FFE9E9E9" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="#FFD2D2D2" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#FFDEDEDE" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#FFC7C7C7" />
     <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FF8993A0" />
     <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FF778391" />
     <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FF4C596A" />
     <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF778391" />
     <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF4C596A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="TabViewBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TabViewItemBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
     <SolidColorBrush x:Key="TabViewItemSeparator" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
     <SolidColorBrush x:Key="TabViewItemUnselectedBackground" Color="{ThemeResource SystemColorButtonFaceColor}" />
     <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{ThemeResource SystemColorWindowColor}" />
     <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TextControlBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
     <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
     <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Thickness x:Key="TabViewItemBorderThickness">2</Thickness>
   <Thickness x:Key="TabViewSelectedItemBorderThickness">2,2,2,0</Thickness>
   <Thickness x:Key="TabViewSelectedItemHeaderMargin">0,0,0,1</Thickness>
   <Thickness x:Key="TabViewItemSeparatorMargin">0,4,0,4</Thickness>
   <Style TargetType="controls:TabViewItem">
    <Setter Property="local:TabAppearance.UseDistinctBorders" Value="True" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{ThemeResource TabViewItemBorderBrush}" />
    <Setter Property="Background" Value="{ThemeResource TabViewItemUnselectedBackground}" />
    <Setter Property="Margin" Value="2,0,2,0" />
   </Style>
   <DataTemplate x:Key="ParsedFieldNodeTemplate">
    <TreeViewItem Content="{Binding Content}" HorizontalContentAlignment="Stretch" />
   </DataTemplate>
  </ResourceDictionary>
 </Application.Resources>
</Application>
