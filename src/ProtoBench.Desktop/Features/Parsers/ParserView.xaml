<UserControl x:Class="ProtoBench.Desktop.Features.Parsers.ParserView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:ProtoBench.Desktop.Controls"
 xmlns:parsers="using:ProtoBench.Desktop.Features.Parsers">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Default">
     <SolidColorBrush x:Key="MessageCardBorderBrush" Color="#FF5B5B5B" />
     <SolidColorBrush x:Key="ParserViolationBrush" Color="#FFFF7777" /><SolidColorBrush x:Key="ParserWarningBrush" Color="#FFFFD166" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="MessageCardBorderBrush" Color="#FFB8B8B8" />
     <SolidColorBrush x:Key="ParserViolationBrush" Color="#FFB42318" /><SolidColorBrush x:Key="ParserWarningBrush" Color="#FF806000" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="MessageCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
     <SolidColorBrush x:Key="ParserViolationBrush" Color="{ThemeResource SystemColorWindowTextColor}" /><SolidColorBrush x:Key="ParserWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <parsers:ParserResultPresentation x:Key="ResultPresentation" />
   <parsers:ParserVerticalInsetConverter x:Key="VerticalInset" />
   <parsers:ParserBooleanVisibilityConverter x:Key="CompactVisibility" />
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="20" Spacing="12">
   <TextBlock Text="Log Parser" FontSize="28" FontWeight="SemiBold" />
   <TextBlock Text="Open a log file or paste log text to inspect its records." TextWrapping="Wrap" />
   <Expander x:Name="InputPanel" Header="Log input" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="10">
   <ComboBox x:Name="FormatPicker" Header="Format" HorizontalAlignment="Stretch" />
   <TabView IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" SelectedIndex="0">
    <TabViewItem Header="Paste text" IsClosable="False">
     <StackPanel Spacing="8" Padding="0,8,0,0">
      <TextBox x:Name="PasteInput" Header="Log text" PlaceholderText="Paste or type log text here…" AcceptsReturn="True" TextWrapping="NoWrap" Height="180" FontFamily="Cascadia Mono" />
      <TextBlock Text="Paste or type log text, then choose Parse text. Very large pastes are kept ready for parsing without filling the editor." TextWrapping="Wrap" FontSize="12" />
      <TextBlock x:Name="PasteNotice" TextWrapping="Wrap" FontSize="12" />
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Button x:Name="ParseTextButton" Content="Parse text" />
       <Button x:Name="ClearTextButton" Content="Clear text" />
      </StackPanel>
     </StackPanel>
    </TabViewItem>
    <TabViewItem Header="Open file" IsClosable="False">
     <StackPanel Spacing="8" Padding="0,8,0,0">
      <TextBox x:Name="PathInput" Header="Local file path" PlaceholderText="Paste a path, or use Open file…" />
      <StackPanel Orientation="Horizontal" Spacing="12">
       <Button x:Name="OpenButton" Content="Open file…" />
       <Button x:Name="ParsePathButton" Content="Parse path" />
      </StackPanel>
     </StackPanel>
    </TabViewItem>
   </TabView>
   <StackPanel Orientation="Horizontal" Spacing="12">
    <Button x:Name="CancelButton" Content="Cancel" />
    <ProgressRing x:Name="Progress" Width="24" Height="24" IsActive="False" />
   </StackPanel>
   <Expander Header="Input details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <TextBlock x:Name="FilePath" TextWrapping="Wrap" />
   </Expander>
    </StackPanel>
   </Expander>
   <TextBlock x:Name="Detection" TextWrapping="Wrap" />
   <controls:AdaptiveColumns MinimumColumnWidth="180">
    <TextBox x:Name="SearchInput" Header="Search value" PlaceholderText="Value or text…" />
    <TextBox x:Name="SearchField" Header="Field (optional)" PlaceholderText="DE number, label or name" />
   </controls:AdaptiveColumns>
   <Expander Header="Filters and sort" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="8">
     <controls:AdaptiveColumns MinimumColumnWidth="160">
    <ComboBox x:Name="DirectionPicker" Header="Direction" HorizontalAlignment="Stretch" />
    <ComboBox x:Name="RolePicker" Header="Message role" HorizontalAlignment="Stretch" />
    <ComboBox x:Name="SortPicker" Header="Sort by" HorizontalAlignment="Stretch" />
   </controls:AdaptiveColumns>
   <CheckBox x:Name="Descending" Content="Descending order" />
    </StackPanel>
   </Expander>
   <StackPanel x:Name="ResultsSection" Spacing="{Binding ResultsGap, Source={StaticResource ResultPresentation}}">
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="RecordCount" Text="No input parsed" TextWrapping="Wrap" VerticalAlignment="Center" />
    <ComboBox x:Name="ResultsViewPicker" Grid.Column="1" Width="150" AutomationProperties.Name="Results view" ToolTipService.ToolTip="Switch between message cards and a field table" />
   </Grid>
   <controls:AdaptiveColumns MinimumColumnWidth="220" MaximumColumns="3">
    <ComboBox x:Name="PageSizePicker" Header="Messages per page" HorizontalAlignment="Stretch" />
    <NumberBox x:Name="PageNumber" Header="Page" Minimum="1" Value="1" SpinButtonPlacementMode="Compact" />
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
     <Button x:Name="PreviousPage" Content="Previous page" IsEnabled="False" />
     <Button x:Name="NextPage" Content="Next page" IsEnabled="False" />
    </StackPanel>
   </controls:AdaptiveColumns>
   <Grid x:Name="BrowseLayout" ColumnSpacing="12" RowSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border x:Name="MessagesPanel" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="10" VerticalAlignment="Stretch">
     <Grid RowSpacing="{Binding PanelGap, Source={StaticResource ResultPresentation}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBlock Text="Messages" FontSize="{Binding HeadingFontSize, Source={StaticResource ResultPresentation}}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Text="Select a message · ↑ / ↓ to browse" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" Opacity="0.75" />
      <ListView Grid.Row="2" x:Name="Records" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="0" SelectionMode="Single" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" /></Style></ListView.ItemContainerStyle>
       <ListView.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{ThemeResource MessageCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,0">
         <StackPanel Spacing="{Binding CardGap, Source={StaticResource ResultPresentation}}" Margin="{Binding CardPadding, Source={StaticResource ResultPresentation}, Converter={StaticResource VerticalInset}}" ToolTipService.ToolTip="{Binding Description}">
          <Grid ColumnSpacing="6">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" FontWeight="SemiBold" ToolTipService.ToolTip="{Binding DirectionDescription}"><Run Text="{Binding DirectionSymbol}" Foreground="{Binding DirectionBrush}" /><Run Text=" " /><Run Text="{Binding CardTitle}" /></TextBlock>
           <TextBlock Grid.Column="1" FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="{Binding CardMessage}" FontWeight="SemiBold" Visibility="{Binding CompactCards, Source={StaticResource ResultPresentation}, Converter={StaticResource CompactVisibility}}" />
           <Border Grid.Column="2" Width="9" Height="9" CornerRadius="5" Background="{Binding StatusBrush}" Visibility="{Binding StatusVisibility}" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Checks}" />
          </Grid>
          <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="{Binding CardMessage}" FontWeight="SemiBold" Visibility="{Binding CompactCards, Source={StaticResource ResultPresentation}, Converter={StaticResource CompactVisibility}, ConverterParameter=Invert}" />
          <TextBlock Text="{Binding DateTime}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" Opacity="0.8" />
          <TextBlock Text="{Binding CardTrace}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CardTerminal}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" TextWrapping="Wrap" Opacity="0.8" />
          <TextBlock Text="{Binding CardAcceptor}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" TextWrapping="Wrap" Opacity="0.8" />
          <TextBlock Text="{Binding Checks}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" Foreground="{Binding StatusBrush}" />
         </StackPanel>
         </Border>
        </DataTemplate>
       </ListView.ItemTemplate>
      </ListView>
      <TextBlock Grid.Row="3" FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="NoMatches" Text="No messages match these filters." TextWrapping="Wrap" Visibility="Collapsed" />
     </Grid>
    </Border>
    <Border x:Name="InspectorPanel" Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Stretch">
     <StackPanel Spacing="{Binding PanelGap, Source={StaticResource ResultPresentation}}">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock x:Name="SelectedTitle" Text="Select a message" FontSize="{Binding HeadingFontSize, Source={StaticResource ResultPresentation}}" FontWeight="SemiBold" TextWrapping="Wrap" />
       <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <Button FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="PreviousRecord" Content="↑" ToolTipService.ToolTip="Previous message" AutomationProperties.Name="Previous message" IsEnabled="False" />
        <Button FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="NextRecord" Content="↓" ToolTipService.ToolTip="Next message" AutomationProperties.Name="Next message" IsEnabled="False" />
       </StackPanel>
      </Grid>
      <TextBlock x:Name="SelectedSummary" Text="Its fields and checks will appear here." FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" TextWrapping="Wrap" Opacity="0.75" />
      <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="CheckSummary" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="12">
       <TextBlock Text="● Violation" Foreground="{ThemeResource ParserViolationBrush}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" />
       <TextBlock Text="● Warning" Foreground="{ThemeResource ParserWarningBrush}" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" />
      </StackPanel>
      <TabView FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="InspectorTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" SelectedIndex="0">
       <TabViewItem Header="Fields" IsClosable="False">
        <Grid x:Name="FieldLayout" RowSpacing="8" Margin="0,8,0,0">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="0" /></Grid.RowDefinitions>
         <ListView x:Name="FieldList" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="0" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Message fields">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="6,0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
           <DataTemplate>
            <Grid ColumnSpacing="6" Padding="{Binding FieldPadding, Source={StaticResource ResultPresentation}, Converter={StaticResource VerticalInset}}" ToolTipService.ToolTip="{Binding Validation}">
             <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /></Grid.ColumnDefinitions>
             <TextBlock Text="{Binding Number}" Opacity="0.65" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" />
             <StackPanel Grid.Column="1" Spacing="{Binding FieldGap, Source={StaticResource ResultPresentation}}">
              <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Preview}" FontFamily="Cascadia Mono" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
             </StackPanel>
             <Border Grid.Column="2" Width="8" Height="8" CornerRadius="4" Background="{Binding StatusBrush}" Visibility="{Binding StatusVisibility}" VerticalAlignment="Top" Margin="0,5,0,0" />
            </Grid>
           </DataTemplate>
          </ListView.ItemTemplate>
         </ListView>
         <controls:ColumnResizeHandle x:Name="DetailResizeCursor" Grid.Column="1" Visibility="Collapsed" IsTabStop="False">
         <Thumb x:Name="DetailResizeHandle" IsTabStop="True" MinHeight="60"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Resize field details width"
             ToolTipService.ToolTip="Drag to resize details. Use Left / Right arrow keys, or Home to reset.">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Border Background="Transparent">
             <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
               <VisualState x:Name="Normal" />
               <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" /></VisualState.Setters></VisualState>
               <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource SystemControlHighlightAccentBrush}" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
             </VisualStateManager.VisualStateGroups>
             <Border x:Name="Grip" Width="3" CornerRadius="2" Margin="0,6" HorizontalAlignment="Center" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Border>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
         </controls:ColumnResizeHandle>
         <Border x:Name="FieldDetailPanel" Grid.Column="2" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10" VerticalAlignment="Stretch">
          <ScrollViewer x:Name="FieldDetailScroll" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Field detail panel">
           <Grid RowSpacing="{Binding PanelGap, Source={StaticResource ResultPresentation}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
             <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
             <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="FieldDetailTitle" Text="Field details" FontWeight="SemiBold" TextWrapping="Wrap" />
             <Button FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="CloseFieldDetail" Grid.Column="1" Content="×" ToolTipService.ToolTip="Close field details" AutomationProperties.Name="Close field details" Padding="8,2" />
            </Grid>
            <TextBox Grid.Row="1" FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="FieldValue" Header="Complete value" MaxHeight="120" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6"><Button FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="CopyValue" Content="Copy" IsEnabled="False" /><Button FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="ViewSource" Content="View source" IsEnabled="False" /></StackPanel>
            <TabView Grid.Row="3" FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="FieldDetailTabs" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" SelectedIndex="0">
             <TabViewItem Header="Decoded" IsClosable="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" AutomationProperties.Name="Decoded content">
              <StackPanel Spacing="8" Padding="0,8,0,0">
               <TextBlock x:Name="FieldExplanation" TextWrapping="Wrap" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" />
               <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="NoDecodedFields" Text="No decoded fields supplied." TextWrapping="Wrap" />
            <StackPanel x:Name="DecodedPanel" Spacing="4" Visibility="Collapsed">
             <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="Decoded fields" FontWeight="SemiBold" />
             <Grid Padding="8,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Field" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Value" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" FontWeight="SemiBold" />
             </Grid>
             <ListView x:Name="Fields" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Decoded fields">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" /></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
              <DataTemplate>
               <Grid Padding="{Binding FieldPadding, Source={StaticResource ResultPresentation}, Converter={StaticResource VerticalInset}, ConverterParameter=8}" ColumnSpacing="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ToolTipService.ToolTip="{Binding SourceSummary}" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Margin="{Binding Indent}" Spacing="3">
                 <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                 <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" Opacity="0.75" Visibility="{Binding ShowDecodedDescriptions, Source={StaticResource ResultPresentation}, Converter={StaticResource CompactVisibility}}" />
                </StackPanel>
                <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <Grid.ContextFlyout>
                 <MenuFlyout Opening="SubfieldSourceMenu_Opening">
                  <MenuFlyoutItem Text="View in original message" Click="SubfieldViewSource_Click" />
                 </MenuFlyout>
                </Grid.ContextFlyout>
               </Grid>
              </DataTemplate>
              </ListView.ItemTemplate>
             </ListView>
            </StackPanel>
              </StackPanel>
              </ScrollViewer>
             </TabViewItem>
             <TabViewItem Header="Checks" IsClosable="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" AutomationProperties.Name="Field checks content">
              <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="FieldChecks" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,8,0,0" />
              </ScrollViewer>
             </TabViewItem>
             <TabViewItem Header="Specification" IsClosable="False">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Auto" AutomationProperties.Name="Specification content">
              <StackPanel Spacing="8" Padding="0,8,0,0">
               <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="NoSpecification" Text="No specification supplied for this field." TextWrapping="Wrap" />
               <TextBlock FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" x:Name="FieldSpecification" FontFamily="Cascadia Mono" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
              </StackPanel>
              </ScrollViewer>
             </TabViewItem>
            </TabView>
           </Grid>
          </ScrollViewer>
         </Border>
        </Grid>
       </TabViewItem>
       <TabViewItem Header="Original" IsClosable="False">
        <Grid RowSpacing="8">
         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
         <Button x:Name="CopyOriginal" Content="Copy original" IsEnabled="False" ToolTipService.ToolTip="Copy original text with the line endings supplied by the extension." />
         <RichEditBox Grid.Row="1" FontSize="{Binding SmallFontSize, Source={StaticResource ResultPresentation}}" x:Name="Raw" Header="Original message" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="0" FontFamily="Cascadia Mono" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
       </TabViewItem>
       <TabViewItem x:Name="ChecksTab" Header="Checks" IsClosable="False"><ListView x:Name="Findings" ScrollViewer.VerticalScrollMode="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" /></TabViewItem>
       <TabViewItem Header="Related" IsClosable="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" AutomationProperties.Name="Related messages content">
        <StackPanel Spacing="10" Padding="0,8,0,0">
         <TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" x:Name="RelatedSummary" TextWrapping="Wrap" />
         <ListView x:Name="Related" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" IsItemClickEnabled="True" SelectionMode="None">
          <ListView.ItemTemplate><DataTemplate><StackPanel Spacing="4" Padding="4,8"><TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="{Binding Description}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock FontSize="{Binding BodyFontSize, Source={StaticResource ResultPresentation}}" Text="Select to open this message" Opacity="0.75" /></StackPanel></DataTemplate></ListView.ItemTemplate>
         </ListView>
        </StackPanel>
        </ScrollViewer>
       </TabViewItem>
      </TabView>
     </StackPanel>
    </Border>
   </Grid>
   <Border x:Name="TableHost" Visibility="Collapsed" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12" />
   <StackPanel x:Name="PagingFooter" Orientation="Horizontal" Spacing="8">
    <Button x:Name="PreviousPageBottom" Content="Previous page" IsEnabled="False" />
    <Button x:Name="NextPageBottom" Content="Next page" IsEnabled="False" />
    <TextBlock x:Name="PageCaptionBottom" VerticalAlignment="Center" />
   </StackPanel>
   </StackPanel>
   <Expander x:Name="DiagnosticsPanel" Header="Parsing diagnostics" IsExpanded="False" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <ScrollViewer MaxHeight="300" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Parsing diagnostic details">
     <TextBlock x:Name="Diagnostics" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
    </ScrollViewer>
   </Expander>
   <TextBlock x:Name="Status" TextWrapping="Wrap" />
  </StackPanel>
 </ScrollViewer>
</UserControl>



