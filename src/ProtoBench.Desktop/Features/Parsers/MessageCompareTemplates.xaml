<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<DataTemplate x:Key="ComparisonTemplate" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:parsers="using:ProtoBench.Desktop.Features.Parsers">
              <Grid UseLayoutRounding="True" Margin="0,0,0,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid.Resources>
                  <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                      <ResourceDictionary x:Key="Default">
                        <SolidColorBrush x:Key="ComparisonValueSurface" Color="#FF20242B"/>
                        <SolidColorBrush x:Key="ComparisonValueBorder" Color="#FF7A8492"/>
                        <SolidColorBrush x:Key="ChangedAccent" Color="#FFFFD166"/>
                        <SolidColorBrush x:Key="ChangedSurface" Color="#FF3B3525"/>
                        <SolidColorBrush x:Key="MissingAccent" Color="#FFCEB3FF"/>
                        <SolidColorBrush x:Key="MissingSurface" Color="#FF342E42"/>
                      </ResourceDictionary>
                      <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="ComparisonValueSurface" Color="#FFFFFFFF"/>
                        <SolidColorBrush x:Key="ComparisonValueBorder" Color="#FF788491"/>
                        <SolidColorBrush x:Key="ChangedAccent" Color="#FF805600"/>
                        <SolidColorBrush x:Key="ChangedSurface" Color="#FFFFF4D6"/>
                        <SolidColorBrush x:Key="MissingAccent" Color="#FF6930A0"/>
                        <SolidColorBrush x:Key="MissingSurface" Color="#FFF1E7FC"/>
                      </ResourceDictionary>
                      <ResourceDictionary x:Key="HighContrast">
                        <SolidColorBrush x:Key="ComparisonValueSurface" Color="{ThemeResource SystemColorWindowColor}"/>
                        <SolidColorBrush x:Key="ComparisonValueBorder" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        <SolidColorBrush x:Key="ChangedAccent" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        <SolidColorBrush x:Key="ChangedSurface" Color="{ThemeResource SystemColorWindowColor}"/>
                        <SolidColorBrush x:Key="MissingAccent" Color="{ThemeResource SystemColorWindowTextColor}"/>
                        <SolidColorBrush x:Key="MissingSurface" Color="{ThemeResource SystemColorWindowColor}"/>
                      </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                    <parsers:MessageCompareStatusVisibility x:Key="StatusVisibility"/>
                    <parsers:MessageCompareDirectionIcon x:Key="DirectionIcon"/>
                  </ResourceDictionary>
                </Grid.Resources>
                <Border Background="{ThemeResource ChangedSurface}" CornerRadius="8"
                    Visibility="{Binding Status, Converter={StaticResource StatusVisibility}, ConverterParameter=Changed}"/>
                <Border Background="{ThemeResource MissingSurface}" CornerRadius="8"
                    Visibility="{Binding Status, Converter={StaticResource StatusVisibility}, ConverterParameter=Missing}"/>
                <Border BorderThickness="4,0,0,0" BorderBrush="{ThemeResource ChangedAccent}" CornerRadius="8"
                    Visibility="{Binding Status, Converter={StaticResource StatusVisibility}, ConverterParameter=Changed}"/>
                <Border BorderThickness="4,0,0,0" BorderBrush="{ThemeResource MissingAccent}" CornerRadius="8"
                    Visibility="{Binding Status, Converter={StaticResource StatusVisibility}, ConverterParameter=Missing}"/>
                <Grid Padding="12" RowSpacing="8" ColumnSpacing="8">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.ColumnSpan="2" Spacing="4">
                    <Grid ColumnSpacing="6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <SymbolIcon Symbol="{Binding Path, Converter={StaticResource DirectionIcon}}"
                          Visibility="{Binding Path, Converter={StaticResource DirectionIcon}, ConverterParameter=Visibility}"
                          VerticalAlignment="Top" Margin="0,2,0,0" Width="14" Height="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          AutomationProperties.AccessibilityView="Raw"/>
                      <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                  </StackPanel>
                  <Border Grid.Row="1" Background="{ThemeResource ComparisonValueSurface}" BorderBrush="{ThemeResource ComparisonValueBorder}"
                      BorderThickness="2" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="6">
                      <Border BorderBrush="{ThemeResource ComparisonValueBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                        <TextBlock Text="Message 1" FontSize="13" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock parsers:MessageCompareHighlight.First="{Binding}" FontFamily="Consolas" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                          FontWeight="Normal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Row="1" Grid.Column="1" Background="{ThemeResource ComparisonValueSurface}" BorderBrush="{ThemeResource ComparisonValueBorder}"
                      BorderThickness="2" CornerRadius="6" Padding="8">
                    <StackPanel Spacing="6">
                      <Border BorderBrush="{ThemeResource ComparisonValueBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6">
                        <TextBlock Text="Message 2" FontSize="13" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock parsers:MessageCompareHighlight.Second="{Binding}" FontFamily="Consolas" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                          FontWeight="Normal" Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </DataTemplate>
</ResourceDictionary>
