<UserControl x:Class="ProtoBench.Desktop.Shell.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
               VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
  <StackPanel Margin="24" Spacing="20" HorizontalAlignment="Stretch">
   <StackPanel Spacing="4">
    <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Choose a tool to get started. Your open work stays in the tabs above." TextWrapping="Wrap"
               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </StackPanel>
   <Grid x:Name="Filters" ColumnSpacing="12" RowSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="Search" Header="Find a tool" PlaceholderText="Search name, category or description" />
    <ComboBox x:Name="Category" Grid.Column="1" Header="Show" HorizontalAlignment="Stretch" />
   </Grid>
   <TextBlock x:Name="ToolCount" FontSize="16" FontWeight="SemiBold" />
   <Grid x:Name="ToolCards" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Stretch" />
   <StackPanel x:Name="EmptyState" Spacing="8" Visibility="Collapsed">
    <TextBlock Text="No matching tools" FontSize="20" />
    <TextBlock Text="Try another search or choose All tools." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    <Button x:Name="ResetFilters" Content="Clear filters" />
   </StackPanel>
   <StackPanel Spacing="8">
    <TextBlock Text="Recent files" FontSize="20" FontWeight="SemiBold" />
    <StackPanel x:Name="RecentFiles" Spacing="4" />
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
